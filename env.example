# /etc/sms-handler/env — copy here and fill in values if you use the systemd service file

HOST=0.0.0.0
PORT=8080

# Set to 0 to disable SMS polling
POLL_INTERVAL=30

# Script to execute on each new SMS (receives SMS_1_NUMBER + SMS_1_TEXT env vars)
# For Docker: place script in ./scripts/ and set path to /scripts/your_script.py
ON_SMS_SCRIPT=
# Webhook URL to POST on each new SMS (JSON: {"number": "...", "text": "..."})
ON_SMS_WEBHOOK=

DB_PATH=/var/lib/sms-handler/sms.db

# Path to gammu config; leave empty to use gammu's auto-detection
GAMMU_CONFIG=/etc/gammurc

# How often (seconds) to push status updates to connected WebSocket clients
STATUS_INTERVAL=60

# Script/webhook to call on each status tick (same pattern as SMS above)
ON_STATUS_SCRIPT=
ON_STATUS_WEBHOOK=
